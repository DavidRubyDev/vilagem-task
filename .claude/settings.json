{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "Bash(gh repo sync *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
