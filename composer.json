{
    "name": "parcel-map/parcel-map",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.6"
    },
    "require-dev": {
        "ext-curl": "*",
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "ParcelMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ParcelMap\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
